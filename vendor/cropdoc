# cropdoc — single static CLI binary: perspective-corrects + enhances a JPEG
# photo of a document. Installed to /opt/cropdoc.

# check: test -x /opt/cropdoc/cropdoc
set -e
curl -fsSL -o /tmp/cropdoc-linux-x86_64 \
  https://raw.githubusercontent.com/vovanmozg/cropdoc/main/cropdoc-linux-x86_64
sudo install -d /opt/cropdoc
sudo install -m 0755 /tmp/cropdoc-linux-x86_64 /opt/cropdoc/cropdoc
rm -f /tmp/cropdoc-linux-x86_64
